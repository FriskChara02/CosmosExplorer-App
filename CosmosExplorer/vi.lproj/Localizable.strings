/*Personality Section*/
"intelligent_creative" = "Thông minh & Sáng tạo";
"intelligent_creative_desc" = "Quán quân trí tuệ 12 cung. Sáng tạo, lập dị, đam mê khoa học. Có hai kiểu: nhút nhát & lập dị. Phong cách ăn mặc kỳ lạ, tò mò mọi thứ mới mẻ.";
"sensitive_kind" = "Nhạy cảm & Nhân hậu";
"sensitive_kind_desc" = "Dễ tổn thương, khép kín, xây tường bảo vệ. Giúp đỡ không cần đền đáp. Nhạy cảm, thế giới nội tâm phong phú, dễ buồn vui thất thường.";
"changeable_complex" = "Thay đổi & Khó hiểu";
"changeable_complex_desc" = "Tính cách thất thường: lúc nhiệt tình, lúc cô độc. Ưa nịnh, thích khen, không nhận sai. Ngoan cố, cứng đầu, nhưng vị tha, không tham lam.";
"dreams_ideals" = "Ước mơ & Lý tưởng";
"dreams_ideals_desc" = "Lạc quan, sống đơn giản: 'làm điều mình thích'. Không tham vọng quyền lực. Là biểu tượng khoa học, công nghệ, ước mơ cao đẹp của nhân loại.";
"observation_memory" = "Quan sát & Trí nhớ";
"observation_memory_desc" = "Con mắt tinh tế, nhìn xa trông rộng. Trí nhớ tốt với kiến thức, nhưng hay quên đồ. Tò mò, sáng tạo, lập dị khi trí tưởng tượng bùng nổ.";
"communication_personality" = "Giao tiếp & Tính cách";
"communication_personality_desc" = "Thật thà, trung thành, yêu công bằng. Ghét thất hứa, cô đơn. Nóng giận nhanh qua, không thù hằn. Sống phóng khoáng, cởi mở, nhưng khó hiểu.";
/*Love Section*/
"late_love" = "Tình yêu muộn";
"late_love_desc" = "Rụt rè, giữ khoảng cách. Tình yêu đến muộn, cần thời gian tìm hiểu. Chung thủy, lãng mạn, dễ ghen mù quáng. Tình yêu như nguồn sống, tiếp thêm động lực.";
"family" = "Gia đình";
"family_desc" = "Làm cha mẹ tâm lý, dạy con khoa học. Kết hôn muộn, nghiêm khắc nhưng yêu thương. Mong tổ ấm hạnh phúc, gắn bó.";
/*Conquest*/
"conquest" = "Chinh phục";
"male" = "Nam giới";
"male_conquest" = "Thích tự do, bàn luận đám đông. Hãy đẹp & quyến rũ.";
"female" = "Nữ giới";
"female_conquest" = "Thích du lịch, bất ngờ. Tặng quà độc đáo.";
