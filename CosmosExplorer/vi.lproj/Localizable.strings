/* Legend Section */
"greek_myth_orion" = "Thần thoại Hy Lạp - Orion";
"hera_scorpion_orion" = "Nữ thần Hera ra lệnh cho bọ cạp giết thợ săn Orion. Bọ cạp chui từ đất lên tấn công khiến Orion không kịp trở tay. Cả hai hóa thành chòm sao, nằm đối lập. Có ý kiến cho rằng Apollo ghen tị với Artemis nên sai khiến bọ cạp. Sau hối hận, Apollo đưa Orion lên trời.";
"phaethon_story" = "Phaethon và Bọ Cạp Khổng Lồ";
"phaethon_scorpion" = "Phaethon nài nỉ cha Helios cho lái cỗ xe mặt trời. Ngựa hoảng loạn vì bọ cạp khổng lồ, mất kiểm soát. Zeus hất Phaethon khỏi xe để chấm dứt hỗn loạn.";
"symbol_meaning" = "Ý nghĩa biểu tượng";
"scorpion_behavior" = "Bọ cạp sống ở sa mạc, rừng rậm, vỏ cứng, hoạt động ban đêm. Đuôi có nọc độc dùng để săn mồi và tự vệ. Chiến đấu đến chết, kể cả tự sát. Bọ cạp ở Sahara và Mexico nguy hiểm nhất.";
/* Personality Section */
"strong_will" = "Ý chí mạnh mẽ & Quyết đoán";
"strong_will_desc" = "Cung mạnh mẽ nhất. Trẻ em khôn ngoan trước tuổi. Quan hệ sâu sắc, bền chặt. Lớp vỏ lạnh lùng che giấu nội tâm phức tạp.";
"mysterious_eyes" = "Đôi mắt thôi miên";
"mysterious_eyes_desc" = "Đôi mắt cuốn hút, đáng sợ. Cao ráo, ưa nhìn. Dũng cảm, dễ gần, tốt bụng nhưng sở hữu và thù dai.";
"passionate_vindictive" = "Nồng nhiệt & Thù hận";
"passionate_vindictive_desc" = "Cảm xúc cực đoan: bình tĩnh đến dữ dội. Lên kế hoạch trả thù. Chiến đấu đến cùng, không chấp nhận thất bại.";
"three_levels" = "Ba tầng tiến hóa";
"three_levels_desc" = "1. Bọ cạp: nguy hiểm, tội phạm.\n2. Đại bàng: tham vọng, thành công kinh doanh.\n3. Phượng hoàng: xuất chúng, quyền lực.";
"intuition_thinking" = "Trực giác & Tư duy";
"intuition_thinking_desc" = "Quyết định theo cảm tính. Đa nghi, thử thách mối quan hệ. Im lặng ép đối phương nói. Phù hợp làm luật sư, thám tử.";
"loyal_protective" = "Trung thành & Bảo vệ";
"loyal_protective_desc" = "Bảo vệ bản thân và người thân. Lập kế hoạch trước. Chăm chỉ, thẳng thắn, được tôn trọng.";
/* Love Section */
"intense_love" = "Tình yêu mãnh liệt";
"intense_love_desc" = "Kín đáo, chọn người thông minh, trung thành. Yêu nồng nhiệt, xây dựng mối quan hệ lâu dài.";
"family_scorpio_desc" = "Chăm sóc gia đình tận tâm. Luôn dành thời gian. Mang tiếng cười dù khó khăn. Cảm xúc phức tạp: yêu thương xen nghi ngờ.";
"conquest" = "Chinh phục";
"male" = "Nam";
"male_conquest_scorpio" = "Hiếu thắng, thích chinh phục. Thực tế, hành động nhiều hơn nói. Sở hữu và ghen tuông.";
"female" = "Nữ";
"female_conquest_scorpio" = "Giàu tình cảm, hy sinh, chung thủy. Vợ đảm đang, không để gia đình thiếu thốn.";
"dating_tips" = "Mẹo hẹn hò";
"dating_tips_desc" = "NÊN: Ăn mặc nổi bật, chọn địa điểm bí ẩn, lắng nghe, chân thành, tặng quà bất ngờ.\nKHÔNG NÊN: Nói dối, hỏi riêng tư, tranh cãi, đăng mạng xã hội, quá thân mật.";

