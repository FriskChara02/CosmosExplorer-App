"babylon_god" = "Thần Babylon";
"ea_sea_goat" = "Thần Ea có cơ thể nửa người nửa động vật: đuôi cá, mình dê đầu người. Ban ngày canh giữ đất liền, đêm về đại dương. Ma Kết (dê biển) là hình ảnh biểu tượng.";
"greek_myth" = "Thần thoại Hy Lạp";
"pan_hermes" = "Pan – con của Hermes và Nymph – sinh ra nửa người nửa dê. Hermes đưa lên Olympus. Pan trở thành thần gia súc, sống trong rừng.";
"symbol_meaning" = "Ý nghĩa biểu tượng";
"nam_duong_nile" = "Nam Dương nhảy xuống sông Nile trong cuộc chiến Titans, biến thành sinh vật nửa dê nửa cá. Biểu tượng Ma Kết là đầu dê.";
/* Personality Section */
"ambitious_determined" = "Tham vọng & Kiên định";
"ambitious_desc" = "Nhiều ước mơ, hoài bão. Không bao giờ đầu hàng. Làm việc cần mẫn, có định hướng rõ ràng. Nắm bắt mọi cơ hội.";
"disciplined_patient" = "Kỷ luật & Kiên nhẫn";
"disciplined_desc" = "Sống theo nguyên tắc, coi trọng luật lệ. Nghiêm túc, không hài hước. Tha thứ, nhường nhịn. Thành công nhờ kiên nhẫn.";
"reserved_principled" = "Kín đáo & Nguyên tắc";
"reserved_desc" = "Nhút nhát, sống nội tâm. Cẩn thận trong quan hệ. Giữ kín kế hoạch. Tự tạo số phận.";
"goal_oriented" = "Hướng mục tiêu";
"goal_desc" = "Thành công là đích đến: tiền bạc, quyền lực, tình yêu. Tự thúc đẩy bản thân. Vượt thất bại bằng ý chí mạnh mẽ.";
"logical_practical" = "Logic & Thực tế";
"logical_desc" = "Cẩn thận, phân tích. Tránh rủi ro. Biến xấu thành tốt. Làm việc chậm rãi, không vội vàng.";
"responsible_leader" = "Trách nhiệm & Lãnh đạo";
"responsible_desc" = "Độc lập, chăm chỉ. Được ngưỡng mộ vì kỷ luật. Sếp công tư phân minh, thưởng phạt rõ ràng.";
/* Love Section */
"cautious_love" = "Tình yêu thận trọng";
"cautious_love_desc" = "Nghiêm túc trong tình yêu. Không dễ bày tỏ. Cần thời gian tin tưởng. Chung thủy, trung thành.";
"family" = "Gia đình";
"family_desc" = "Cha mẹ nghiêm khắc nhưng yêu thương. Giữ nhà sạch sẽ, ngăn nắp. Tiết kiệm, không lãng phí.";
/* Conquest */
"conquest" = "Chinh phục";
"male" = "Nam";
"male_conquest" = "Phá vỡ lớp vỏ lạnh lùng. Thể hiện sự ấm áp, chân thành. Nhắn tin buổi sáng.";
"female" = "Nữ";
"female_conquest" = "Kiên nhẫn, chậm rãi. Đưa đến nơi yên tĩnh: hòa nhạc, rạp phim. Tránh vội vàng.";
/* Career Section */
"career" = "Sự nghiệp";
"career_desc" = "Tham vọng lớn, tổ chức tốt. Xuất sắc trong tài chính, bất động sản, luật pháp. Lãnh đạo công bằng.";
"finance" = "Tài chính";
"finance_desc" = "Giỏi kiếm tiền và tiết kiệm. Không hoang phí. Đầu tư khôn ngoan.";
"suitable_jobs" = "Công việc phù hợp";
"suitable_jobs_desc" = "Bất động sản, ngân hàng, luật sư, chính trị, quản lý, khoa học, lịch sử, công nghệ, y khoa.";

