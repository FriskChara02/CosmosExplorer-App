"centaur_chiron" = "Chiron - Người Ngựa";
"centaur_chiron_desc" = "Đa số Centaurs ngu dốt, bạo lực. Nhưng Chiron - cháu thần biển Ocesnus, con Kronos - thông minh, khôn ngoan, tốt bụng. Giúp người khó khăn, dạy trẻ nhỏ.";
"heracles_arrow" = "Mũi Tên Heracles";
"heracles_arrow_desc" = "Tiêu diệt ác thú, Chiron bị Heracles bắn nhầm mũi tên tẩm độc rắn. Đau đớn tột cùng nhưng không chết được vì là thần.";
"prometheus_sacrifice" = "Sự Hy Sinh Của Prometheus";
"prometheus_sacrifice_desc" = "Prometheus biến Chiron thành người thường để linh hồn bay lên trời. Chòm sao Nhân Mã tưởng nhớ Chiron.";
"archer_symbol_desc" = "Biểu tượng mũi tên sắc nhọn. Trong thần thoại Sumeria là quái vật hung dữ, trong Rome là Chiron thông minh. Phản ánh tính cách: vui vẻ nhưng cũng ghê gớm.";
/* Personality Section */
"cheerful_generous" = "Vui Vẻ & Hào Phóng";
"cheerful_generous_desc" = "Dễ thương, hòa đồng, hào phóng. Cởi mở, chia sẻ kế hoạch, không giấu diếm. Ham học, say mê lĩnh vực yêu thích. Thô lỗ nhưng thật thà. Chi tiêu thoải mái, hay hết tiền.";
"knowledge_exploration" = "Kiến Thức & Khám Phá";
"knowledge_exploration_desc" = "Sống động, đam mê khám phá. Thích du lịch nơi đẹp, yên bình. Hướng ngoại, nhiệt tình giúp người. Luôn làm mới bản thân tích cực.";
"adventurous_brave" = "Mạo Hiểm & Dũng Cảm";
"adventurous_brave_desc" = "Gan dạ, thích trò chơi nguy hiểm. Phù hợp công việc thử thách: điệp viên, thám tử. Sao Mộc ban trí tuệ, cân bằng tính cách để thành công.";
"sociable_humorous" = "Giao Tiếp & Hài Hước";
"sociable_humorous_desc" = "Hài hước, hòa đồng, đáng tin. Thẳng thắn quá có thể làm mất lòng. Ghét nói dối, nổi giận khi phát hiện dối trá.";
"optimistic_philosophical" = "Lạc Quan & Triết Lý";
"optimistic_philosophical_desc" = "Suy nghĩ sâu, hay diễn thuyết. Nhiều nhà văn, nhà báo nổi tiếng. Bị cho là khoe khoang nhưng có tầm nhìn. Ăn mặc giản dị, nhà sáng sủa, hài hòa.";
"blunt_impatient" = "Thẳng Thắn & Nóng Vội";
"blunt_impatient_desc" = "Thô lỗ, thiếu tế nhị. Cung đa tình nhất. Hoang dã, tự do như ngựa. Hành động nhanh, không thích ràng buộc.";
/* Love Section */
"passionate_love" = "Tình Yêu Nồng Nhiệt";
"passionate_love_desc" = "Hài hước, mang niềm vui. Trung thành khi yêu, tiêu chuẩn cao. Yêu tự do, khó kiểm soát. Trưởng thành: tìm mối quan hệ sâu sắc. Chung thủy nhưng cần không gian.";
"family_sagittarius_desc" = "Thích tụ tập đông, không thích gia đình nhỏ. Dạy con tự lập. Bị xem vô trách nhiệm nhưng mang niềm vui. Ưu tiên tự do, viễn du.";
/* Conquest */
"conquest" = "Chinh Phục";
"male" = "Nam";
"male_conquest_sagittarius" = "Thích mạo hiểm, hài hước, tự do. Hãy vui vẻ, độc lập, cùng khám phá.";
"female" = "Nữ";
"female_conquest_sagittarius" = "Hấp dẫn bởi trí tuệ, lạc quan. Chia sẻ ước mơ, cùng trải nghiệm.";
/* Career Section */
"suitable_careers" = "Nghề Nghiệp Phù Hợp";
"suitable_careers_desc" = "Nhà thám hiểm, nhà báo, giáo viên, tiếp thị, hướng dẫn viên, ngoại giao, phiên dịch, kinh doanh. Yêu tự do, giao tiếp, truyền cảm hứng.";
"finance_sagittarius_desc" = "Kiếm tiền giỏi, chi tiêu phóng khoáng. Hiếm khi thiếu nhưng không dư dả. Lạc quan, tràn năng lượng dù khó khăn.";
"work_style" = "Phong Cách Làm Việc";
"work_style_desc" = "Năng động, nhanh nhẹn, có động lực. Ghét lặp lại. Sếp tuyệt vời: truyền cảm hứng, sáng tạo. Đồng nghiệp yêu sự hài hước, lạc quan.";

